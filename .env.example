# Local development environment (copy to .env and adjust).
# The .env file is git-ignored.

# HTTP port the app listens on.
PORT=:8080

# SQLite database file. Created automatically on first run,
# migrations are applied on every boot.
DATABASE_PATH=./data/app.db

# Directory for uploaded files (contact photo, ...). Created automatically,
# git-ignored together with the whole data/ directory.
UPLOAD_DIR=./data/uploads

# Log level: debug, info, warn or error.
LOG_LEVEL=info

# Timetout for graceful shutdown in seconds
FORCE_SHUTDOWN_AFTER_IN_SECONDS=10

# Initial admin account. Used on first run (or via `make seed`)
# when no users exist yet. Safe to leave empty afterwards.
# After first login: rotate password in admin UI and unset both vars in prod.
ADMIN_EMAIL=kontakt@example.com
ADMIN_PASSWORD=zmen-ma-po-prvom-prihlaseni

# Set true in production behind a reverse proxy (TLS termination).
# Enables X-Forwarded-Proto handling for Secure cookies + client IP.
BEHIND_PROXY=false

# Cookie Secure mode: auto (dev), always (prod behind HTTPS), never (only for local HTTP tests).
COOKIE_SECURE=auto

# --- Production example (/etc/app.env, chmod 600) ---
# PORT=:8080
# DATABASE_PATH=/var/lib/app/app.db
# UPLOAD_DIR=/var/lib/app/uploads
# LOG_LEVEL=info
# FORCE_SHUTDOWN_AFTER_IN_SECONDS=10
# BEHIND_PROXY=true
# COOKIE_SECURE=always
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
