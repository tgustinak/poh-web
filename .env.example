# Local development environment (copy to .env and adjust).
# The .env file is git-ignored.

# HTTP port the app listens on.
PORT=:8080

# SQLite database file. Created automatically on first run,
# migrations are applied on every boot.
DATABASE_PATH=./data/app.db

# Log level: debug, info, warn or error.
LOG_LEVEL=info

# Initial admin account. Used on first run (or via `make seed`)
# when no users exist yet. Safe to leave empty afterwards.
ADMIN_EMAIL=kontakt@example.com
ADMIN_PASSWORD=zmen-ma-po-prvom-prihlaseni
