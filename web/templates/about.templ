package templates

import (
	"github.com/tgustinak/pohkapela.sk/internal/about"
)

templ About(data about.About) {
	<section id="o-nas" class="relative overflow-hidden bg-black border-t border-white/5">
		<img
			src="/static/images/about-bg.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover object-center"
			loading="lazy"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/70 to-black/90"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/50"></div>
		<div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 min-h-[90vh] flex flex-col justify-center">
			<div class="max-w-2xl lg:ml-auto">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">O nás</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Niečo málo o nás</h2>
			<div class="mt-8 space-y-5 text-white/70 leading-relaxed">
				<p>
					{ data.P1 }
				</p>
				<p>
					{ data.P2 }
				</p>
			</div>
			<blockquote class="mt-10 border-l-2 border-amber-400 pl-6">
				<p class="text-xl font-semibold text-white/90 leading-relaxed">
					{ data.Quote }
				</p>
			</blockquote>
			</div>
		</div>
	</section>
}
