package templates

templ About() {
	<section id="o-nas" class="relative overflow-hidden bg-black border-t border-white/5">
		<img
			src="/static/images/about-bg.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover object-center"
			loading="lazy"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/70 to-black/90"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/50"></div>
		<div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 min-h-[90vh] flex flex-col justify-center">
			<div class="max-w-2xl lg:ml-auto">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">O nás</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Niečo málo o nás</h2>
				<div class="mt-8 space-y-5 text-white/70 leading-relaxed">
					<p>
						P.O.H je slovenská folk-rocková kapela, ktorá pochádza z Dolného Kubína a ktorej vznik nebol okamihom,
						ale procesom, takže jeho presné datovanie nie je uchopiteľné; pár rokov to však už bude…
						V zložení dve gitary, basgitara a bicie si prešla mnohými koncertmi, či už na klubových pódiách
						alebo menších i väčších festivaloch v SR a ČR.
					</p>
					<p>
						Na konte má štyri demo albumy: Posledný smiech, Stodola, Deň za dňom, Večnosť
						a jeden štúdiový Na konci sveta (2021). Hrá výsostne vlastnú produkciu a všetky jej texty sú
						v rodnej slovenčine, čo je pre kapelu úplne prirodzené a poslucháčmi (súdiac podľa ich ohlasov) oceňované.
					</p>
				</div>
				<blockquote class="mt-10 border-l-2 border-amber-400 pl-6">
					<p class="text-xl font-semibold text-white/90 leading-relaxed">
						Obojstranný prúd energie na koncertoch je pre P.O.H na nezaplatenie – kto to zažil, ten vie…
					</p>
				</blockquote>
			</div>
		</div>
	</section>
}
