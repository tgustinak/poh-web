package templates

import (
	"github.com/tgustinak/pohkapela.sk/internal/scripts"
	"github.com/tgustinak/pohkapela.sk/web/templates"
)

templ AdminLayout(title string, active string, csrf string) {
	@templates.Base("Admin – " + title) {
		<div class="min-h-screen bg-neutral-950 lg:flex">
			<aside class="hidden lg:flex w-64 shrink-0 flex-col border-r border-white/10 bg-black/70 sticky top-0 h-screen">
				<div class="flex items-center gap-3 px-6 h-20 border-b border-white/10">
					<img src="/static/images/logo.svg" alt="P.O.H" class="h-8 w-auto"/>
					<span class="text-xs font-bold uppercase tracking-[0.25em] text-brand-400">Admin</span>
				</div>
				<nav class="flex-1 px-3 py-6 flex flex-col gap-1">
					@AdminNavItem("/admin/dashboard", "Prehľad", active == "dashboard", "M4 4h7v7H4zM13 4h7v4h-7zM13 11h7v9h-7zM4 14h7v6H4z")
					@AdminNavItem("/admin/music", "Hudba", active == "music", "M9 18V5l11-2.5V16")
					@AdminNavItem("/admin/concerts", "Koncerty", active == "concerts", "M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z")
					@AdminNavItem("/admin/videos", "Klipy", active == "videos", "M12 21a9 9 0 100-18 9 9 0 000 18zM10 8.5l6 3.5-6 3.5z")
					@AdminNavItem("/admin/about", "O nás", active == "about", "M7 3h8l4 4v14H7zM15 3v4h4M10 12h5M10 16h5")
					@AdminNavItem("/admin/social", "Social", active == "social", "M12 12a4 4 0 100-8 4 4 0 000 8zM16 8v5a3 3 0 01-6 0v-1a3 3 0 016 0")
					@AdminNavItem("/admin/contact", "Kontakt", active == "contact", "M3 7l9 6 9-6M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z")
					@AdminNavItem("/admin/organizers", "Organizátori", active == "organizers", "M3 8h18v11H3zM9 8V6a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18")
					@AdminNavItem("/admin/logs", "Logy", active == "logs", "M4 6h16M4 12h16M4 18h10")
				</nav>
				<div class="p-4 border-t border-white/10 flex flex-col gap-2">
					<a href="/" target="_blank" rel="noopener" class="admin-nav-item">Zobraziť web <span aria-hidden="true">↗</span></a>
					<form method="POST" action="/admin/logout" hx-post="/admin/logout" hx-swap="none">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<button type="submit" class="admin-nav-item w-full text-left cursor-pointer">Odhlásiť</button>
					</form>
				</div>
			</aside>
			<div class="flex-1 min-w-0">
				<div class="lg:hidden sticky top-0 z-40 bg-black/90 backdrop-blur border-b border-white/10">
					<div class="flex items-center justify-between px-4 h-16">
						<div class="flex items-center gap-2">
							<img src="/static/images/logo.svg" alt="P.O.H" class="h-7 w-auto"/>
							<span class="text-xs font-bold uppercase tracking-[0.25em] text-brand-400">Admin</span>
						</div>
						<div class="flex items-center gap-3">
							<form method="POST" action="/admin/logout" hx-post="/admin/logout" hx-swap="none">
								<input type="hidden" name="csrf_token" value={ csrf }/>
								<button type="submit" class="text-xs font-semibold text-white/60 transition hover:text-brand-400 cursor-pointer">Odhlásiť</button>
							</form>
							<a href="/" class="text-xs font-semibold text-white/60">Zobraziť web ↗</a>
						</div>
					</div>
					<nav class="flex gap-2 overflow-x-auto px-4 pb-3">
						@AdminNavPill("/admin/dashboard", "Prehľad", active == "dashboard")
						@AdminNavPill("/admin/music", "Hudba", active == "music")
						@AdminNavPill("/admin/concerts", "Koncerty", active == "concerts")
						@AdminNavPill("/admin/videos", "Klipy", active == "videos")
						@AdminNavPill("/admin/about", "O nás", active == "about")
						@AdminNavPill("/admin/social", "Social", active == "social")
						@AdminNavPill("/admin/contact", "Kontakt", active == "contact")
						@AdminNavPill("/admin/organizers", "Organizátori", active == "organizers")
						@AdminNavPill("/admin/logs", "Logy", active == "logs")
					</nav>
				</div>
				<main class="px-4 sm:px-8 py-8 sm:py-10 max-w-5xl">
					{ children... }
				</main>
			</div>
		</div>
		@AdminScripts(csrf)
		@scripts.Defer("admin-demo", AdminDemoScripts())
	}
}

templ AdminDemoScripts() {
	<script>
			document.querySelectorAll('form[data-demo]').forEach(f => {
				f.addEventListener('submit', (e) => {
					e.preventDefault();
					adminToast('Demo režim — napoj na backend');
				});
			});
			document.querySelectorAll('[data-demo-delete]').forEach(b => {
				b.addEventListener('click', () => {
					if (confirm('Naozaj zmazať?')) {
						adminToast('Demo režim — napoj na backend');
					}
				});
			});
	</script>
}

templ AdminNavItem(href string, label string, isActive bool, icon string) {
	<a href={ href } class={ "admin-nav-item", templ.KV("admin-nav-item-active", isActive) }>
		<svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d={ icon }></path>
		</svg>
		{ label }
	</a>
}

templ AdminNavPill(href string, label string, isActive bool) {
	<a href={ href } class={ "admin-nav-pill", templ.KV("admin-nav-pill-active", isActive) }>{ label }</a>
}

templ AdminPageHeader(title string, sub string) {
	<div class="mb-8">
		<h1 class="text-3xl font-bold text-white">{ title }</h1>
		<p class="mt-1 text-sm text-white/50">{ sub }</p>
	</div>
}
