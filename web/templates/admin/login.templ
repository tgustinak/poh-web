package templates

import "github.com/tgustinak/pohkapela.sk/web/templates"

templ AdminLogin(errMsg string, csrf string) {
	@templates.Base("Admin – Prihlásenie") {
		<div class="min-h-screen bg-neutral-950 flex items-center justify-center px-4">
			<div class="w-full max-w-sm">
				<div class="text-center">
					<img src="/static/images/logo.svg" alt="P.O.H" class="mx-auto h-14 w-auto"/>
					<p class="mt-4 text-xs font-bold uppercase tracking-[0.25em] text-brand-400">Admin</p>
				</div>
				<div class="admin-card mt-8">
					if errMsg != "" {
						<p role="alert" class="mb-4 rounded-lg border border-red-400/40 bg-red-400/10 px-4 py-2.5 text-sm font-semibold text-red-300">{ errMsg }</p>
					}
					<form method="POST" action="/admin/login" hx-post="/admin/login" hx-swap="none" class="flex flex-col gap-4">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<div>
							<label class="admin-label" for="login-email">E-mail</label>
							<input id="login-email" name="email" type="email" required autocomplete="username" placeholder="e-mail" class="admin-input"/>
						</div>
						<div>
							<label class="admin-label" for="login-password">Heslo</label>
							<input id="login-password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" class="admin-input"/>
						</div>
						<button type="submit" class="admin-btn w-full justify-center mt-2">Prihlásiť sa</button>
					</form>
				</div>
				<p class="mt-6 text-center">
					<a href="/" class="text-sm text-white/50 transition hover:text-brand-400">← Späť na web</a>
				</p>
			</div>
		</div>
		@AdminScripts(csrf)
	}
}
