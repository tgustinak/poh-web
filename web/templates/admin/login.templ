package templates

import "github.com/tgustinak/pohkapela.sk/web/templates"

templ AdminLogin() {
	@templates.Base("Admin – Prihlásenie") {
		<div class="min-h-screen bg-neutral-950 flex items-center justify-center px-4">
			<div class="w-full max-w-sm">
				<div class="text-center">
					<img src="/static/images/logo.svg" alt="P.O.H" class="mx-auto h-14 w-auto"/>
					<p class="mt-4 text-xs font-bold uppercase tracking-[0.25em] text-amber-400">Admin</p>
				</div>
				<div class="admin-card mt-8">
					<form id="admin-login-form" class="flex flex-col gap-4">
						<div>
							<label class="admin-label" for="login-email">E-mail</label>
							<input id="login-email" type="email" required autocomplete="username" placeholder="kontakt@example.com" class="admin-input"/>
						</div>
						<div>
							<label class="admin-label" for="login-password">Heslo</label>
							<input id="login-password" type="password" required autocomplete="current-password" placeholder="••••••••" class="admin-input"/>
						</div>
						<button type="submit" class="admin-btn w-full justify-center mt-2">Prihlásiť sa</button>
					</form>
				</div>
				<p class="mt-6 text-center">
					<a href="/" class="text-sm text-white/50 transition hover:text-amber-400">← Späť na web</a>
				</p>
			</div>
		</div>
		<script>
			document.getElementById('admin-login-form')?.addEventListener('submit', (e) => {
				e.preventDefault();
				window.location.href = '/admin/dashboard';
			});
		</script>
	}
}
