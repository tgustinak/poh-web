package templates

import (
	"github.com/tgustinak/pohkapela.sk/internal/db"
	"github.com/tgustinak/pohkapela.sk/internal/social"
)

templ AdminSocial(rows []db.SocialLink, csrf string) {
	@AdminLayout("Social", "social", csrf) {
		@AdminPageHeader("Social", "Linky na sociálne siete a streamovacie služby — fixných 6 sietí, upravuje sa názov a URL")
		<div class="admin-card">
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="text-left text-xs uppercase tracking-wider text-white/40">
							<th class="pb-3 pr-4 font-semibold">Sieť</th>
							<th class="pb-3 pr-4 font-semibold">Zobrazovaný názov</th>
							<th class="pb-3 pr-4 font-semibold">URL</th>
							<th class="pb-3 pr-4 font-semibold">Tlačidlo</th>
							<th class="pb-3 font-semibold text-right">Akcie</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range rows {
							@AdminSocialRow(l, "")
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ AdminSocialRow(l db.SocialLink, errMsg string) {
	<tr class="border-t border-white/10">
		<td class="py-3 pr-4 font-semibold text-white">{ l.DisplayName }</td>
		<td class="py-3 pr-4 text-white/70">{ l.Handle }</td>
		<td class="py-3 pr-4 text-white/50 break-all max-w-64">{ l.Url }</td>
		<td class="py-3 pr-4 text-white/40 whitespace-nowrap">{ social.Cta(l.Platform) }</td>
		<td class="py-3">
			<div class="flex justify-end gap-2">
				<button type="button" class="admin-btn-row cursor-pointer" hx-get={ socialURL(l.Platform, "/edit") } hx-target="closest tr" hx-swap="outerHTML">Upraviť</button>
			</div>
		</td>
	</tr>
}

templ AdminSocialEditRow(l db.SocialLink, errMsg string) {
	<tr class="border-t border-brand-400/40 bg-brand-400/[0.04]">
		<td colspan="5" class="px-4 py-4">
			if errMsg != "" {
				<p role="alert" class="mb-3 text-sm font-semibold text-red-300">{ errMsg }</p>
			}
			<form hx-put={ socialURL(l.Platform, "") } hx-target="closest tr" hx-swap="outerHTML" class="grid gap-3 sm:grid-cols-2">
				<div class="sm:col-span-2">
					<p class="text-sm font-semibold text-white">{ l.DisplayName } <span class="ml-2 text-xs font-normal text-white/40">tlačidlo: { social.Cta(l.Platform) }</span></p>
				</div>
				<div>
					<label class="admin-label" for={ "edit-handle-" + l.Platform }>Zobrazovaný názov / handle</label>
					<input id={ "edit-handle-" + l.Platform } name="handle" type="text" required maxlength="100" value={ l.Handle } autocomplete="off" class="admin-input"/>
				</div>
				<div>
					<label class="admin-label" for={ "edit-url-" + l.Platform }>URL</label>
					<input id={ "edit-url-" + l.Platform } name="url" type="url" required maxlength="500" value={ l.Url } placeholder="https://…" class="admin-input"/>
				</div>
				<div class="sm:col-span-2 flex gap-2">
					<button type="submit" class="admin-btn-row cursor-pointer">Uložiť</button>
					<button type="button" class="admin-btn-row cursor-pointer" hx-get={ socialURL(l.Platform, "") } hx-target="closest tr" hx-swap="outerHTML">Zrušiť</button>
				</div>
			</form>
		</td>
	</tr>
}

func socialURL(platform string, suffix string) string {
	return "/admin/social/" + platform + suffix
}
