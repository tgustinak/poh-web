package templates

templ Contact() {
	<section id="kontakt" class="bg-neutral-950 border-t border-white/5">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">Kontakt</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Kontakt</h2>
				<p class="mt-4 max-w-2xl mx-auto text-white/60">
					Booking, koncerty, merch — ozvi sa našej manažérke.
				</p>
			</div>
			<div class="mt-16 max-w-3xl mx-auto rounded-3xl border border-white/10 bg-white/[0.03] p-8 sm:p-10 shadow-2xl shadow-black/60">
				<div class="flex flex-col sm:flex-row items-center gap-8 sm:gap-10">
					<img
						src="/static/images/manager.webp"
						alt="Jana Testová – manažérka kapely P.O.H"
						class="shrink-0 w-44 h-44 sm:w-52 sm:h-52 rounded-full object-cover ring-2 ring-amber-400/60 ring-offset-4 ring-offset-neutral-950 shadow-xl shadow-black/50"
						loading="lazy"
					/>
					<div class="text-center sm:text-left min-w-0 w-full">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400/90">Manažérka</p>
						<h3 class="mt-2 text-3xl font-bold text-white">Jana Testová</h3>
						<div class="mt-6 flex flex-col gap-3">
							<a
								href="tel:+421900123456"
								class="group flex items-center gap-4 rounded-xl border border-white/10 bg-black/40 px-5 py-4 transition hover:border-amber-400/50"
							>
								<span class="flex items-center justify-center w-10 h-10 shrink-0 rounded-lg bg-amber-400/10 text-amber-400 transition group-hover:bg-amber-400 group-hover:text-black">
									<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"></path>
									</svg>
								</span>
								<span class="text-left">
									<span class="block text-xs uppercase tracking-wider text-white/40">Telefón</span>
									<span class="block font-semibold text-white">+421 900 123 456</span>
								</span>
							</a>
							<a
								href="mailto:kontakt@example.com"
								class="group flex items-center gap-4 rounded-xl border border-white/10 bg-black/40 px-5 py-4 transition hover:border-amber-400/50"
							>
								<span class="flex items-center justify-center w-10 h-10 shrink-0 rounded-lg bg-amber-400/10 text-amber-400 transition group-hover:bg-amber-400 group-hover:text-black">
									<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
									</svg>
								</span>
								<span class="text-left">
									<span class="block text-xs uppercase tracking-wider text-white/40">E-mail</span>
									<span class="block font-semibold text-white break-all">kontakt@example.com</span>
								</span>
							</a>
						</div>
					</div>
				</div>
			</div>
			<div class="mt-10 text-center">
				<a href="/pre-organizatorov" class="group inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-white/60 transition hover:text-amber-400">
					Organizuješ akciu? Info pre organizátorov
					<span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
				</a>
			</div>
		</div>
	</section>
	@Footer()
}
