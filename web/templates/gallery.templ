package templates

import (
	"github.com/tgustinak/pohkapela.sk/internal/gallery"
	"github.com/tgustinak/pohkapela.sk/internal/scripts"
)

templ Gallery(items []gallery.Item) {
	<section id="galeria" class="bg-neutral-950 border-t border-white/5">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand-400">Fotky a videá</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Galéria</h2>
				<p class="mt-4 max-w-2xl mx-auto text-white/60">
					Pohľad do zákulisia — fotky a videá z koncertov, skúšok a ciest.
				</p>
			</div>
			if len(items) == 0 {
				<p class="mt-16 text-center text-white/50">Zatiaľ žiadne fotky ani videá.</p>
			} else {
				<div class="mt-16 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
					for _, item := range items {
						@GalleryTile(item)
					}
				</div>
			}
		</div>
		@GalleryLightbox()
	</section>
	@scripts.Defer("gallery", GalleryScripts())
}

templ GalleryTile(item gallery.Item) {
	<button
		type="button"
		class="gallery-tile group relative block w-full overflow-hidden rounded-xl border border-white/10 bg-neutral-900 text-left transition duration-300 hover:-translate-y-1 hover:border-brand-400/60 hover:shadow-2xl hover:shadow-black/60 cursor-pointer"
		data-gallery-item
		data-kind={ item.Kind }
		data-src={ item.FilePath }
		data-thumb={ item.Thumbnail() }
		data-youtube-id={ item.YoutubeID }
		data-title={ item.DisplayTitle() }
		aria-label={ "Otvoriť " + item.DisplayTitle() }
		onclick="pohGalleryOpen(this)"
	>
		<img
			src={ item.Thumbnail() }
			alt={ item.DisplayTitle() }
			class="block w-full aspect-[4/3] object-cover transition duration-500 group-hover:scale-105"
			loading="lazy"
			decoding="async"
		/>
		<span class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></span>
		if item.IsVideo() {
			<span class="absolute inset-0 flex items-center justify-center">
				<span class="flex items-center justify-center w-14 h-14 rounded-full bg-brand-400 text-black shadow-lg shadow-black/40 transition duration-300 group-hover:scale-110">
					<svg class="w-6 h-6 ml-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
				</span>
			</span>
			<span class="absolute bottom-0 inset-x-0 px-3 pb-3 pt-8">
				<span class="block text-sm font-bold text-white truncate">{ item.DisplayTitle() }</span>
				<span class="mt-0.5 block text-[10px] font-semibold uppercase tracking-wider text-brand-400">YouTube video</span>
			</span>
		} else {
			<span class="absolute right-3 top-3 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white/80 opacity-0 backdrop-blur transition duration-300 group-hover:opacity-100">
				<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="M20 20l-3.5-3.5M11 8v6M8 11h6"></path>
				</svg>
			</span>
			if item.Alt != "" {
				<span class="absolute bottom-0 inset-x-0 px-3 pb-3 pt-8 text-xs font-semibold text-white/80 truncate">{ item.Alt }</span>
			}
		}
	</button>
}

templ GalleryLightbox() {
	<dialog id="gallery-lightbox" class="m-auto w-[min(94vw,72rem)] max-w-none bg-transparent p-0 text-white backdrop:bg-black/90">
		<div class="relative flex max-h-[92dvh] flex-col overflow-hidden rounded-2xl border border-white/10 bg-neutral-950 shadow-2xl shadow-black/70">
			<button type="button" onclick="pohGalleryClose()" aria-label="Zavrieť galériu" class="absolute right-3 top-3 z-20 flex items-center justify-center w-10 h-10 rounded-full bg-black/70 text-xl text-white/80 backdrop-blur transition hover:text-white cursor-pointer">×</button>
			<button type="button" onclick="pohGalleryPrev()" aria-label="Predchádzajúca položka" class="absolute left-3 top-1/2 z-20 flex -translate-y-1/2 items-center justify-center w-10 h-10 rounded-full bg-black/70 text-2xl text-white/80 backdrop-blur transition hover:text-white cursor-pointer">‹</button>
			<button type="button" onclick="pohGalleryNext()" aria-label="Nasledujúca položka" class="absolute right-3 top-1/2 z-20 flex -translate-y-1/2 items-center justify-center w-10 h-10 rounded-full bg-black/70 text-2xl text-white/80 backdrop-blur transition hover:text-white cursor-pointer">›</button>
			<div class="relative flex min-h-0 flex-1 items-center justify-center bg-black">
				<img id="gallery-lightbox-img" alt="" class="hidden max-h-[calc(92dvh-4.5rem)] w-full object-contain"/>
				<div id="gallery-lightbox-video" class="hidden aspect-video max-h-[calc(92dvh-4.5rem)] w-full"></div>
			</div>
			<p id="gallery-lightbox-caption" class="shrink-0 px-5 py-3 text-sm text-white/70 sm:px-6 sm:py-4"></p>
		</div>
	</dialog>
}

templ GalleryScripts() {
	<script>
		(function galleryInit() {
			var dialog = document.getElementById('gallery-lightbox');
			var img = document.getElementById('gallery-lightbox-img');
			var video = document.getElementById('gallery-lightbox-video');
			var caption = document.getElementById('gallery-lightbox-caption');
			var items = [];
			var current = 0;

			if (!dialog || !img || !video || !caption) {
				return;
			}

			function collect() {
				items = Array.prototype.slice.call(document.querySelectorAll('[data-gallery-item]'));
			}

			function hasConsent() {
				try {
					var c = window.pohGetConsent ? window.pohGetConsent() : null;
					return !!(c && c.media);
				} catch (e) {
					return false;
				}
			}

			function clearVideo() {
				video.innerHTML = '';
				video.classList.add('hidden');
			}

			function loadVideo(id) {
				clearVideo();
				video.classList.remove('hidden');

				if (!id) {
					return;
				}

				if (!hasConsent()) {
					var box = document.createElement('div');
					box.className = 'flex h-full flex-col items-center justify-center gap-4 px-6 text-center';
					box.innerHTML = '<p class="text-sm text-white/70">Pre prehratie videa povoľ cookies pre médiá.</p>';

					var btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'inline-flex items-center justify-center rounded-full bg-brand-400 px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-brand-300 cursor-pointer';
					btn.textContent = 'Povoliť a prehrať';
					btn.addEventListener('click', function() {
						if (window.pohConsentAccept) {
							window.pohConsentAccept();
						}
					});

					box.appendChild(btn);
					video.appendChild(box);

					return;
				}

				var frame = document.createElement('iframe');
				frame.className = 'w-full h-full block';
				frame.title = 'Video P.O.H';
				frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
				frame.allowFullscreen = true;
				frame.loading = 'lazy';
				frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?rel=0&autoplay=1';
				video.appendChild(frame);
			}

			function show(index) {
				collect();
				if (!items.length) {
					return;
				}

				current = (index + items.length) % items.length;

				var el = items[current];
				var title = el.dataset.title || '';
				var kind = el.dataset.kind;

				caption.textContent = title;

				if (kind === 'video') {
					img.classList.add('hidden');
					img.removeAttribute('src');
					video.classList.remove('hidden');
					loadVideo(el.dataset.youtubeId);
				} else {
					clearVideo();
					img.classList.remove('hidden');
					img.src = el.dataset.src || el.dataset.thumb || '';
					img.alt = title;
				}

				if (!dialog.open) {
					dialog.showModal();
					document.body.classList.add('overflow-hidden');
				}
			}

			window.pohGalleryOpen = function(el) {
				collect();
				show(items.indexOf(el));
			};

			window.pohGalleryClose = function() {
				dialog.close();
			};

			window.pohGalleryPrev = function() {
				show(current - 1);
			};

			window.pohGalleryNext = function() {
				show(current + 1);
			};

			dialog.addEventListener('close', function() {
				clearVideo();
				document.body.classList.remove('overflow-hidden');
			});

			dialog.addEventListener('click', function(e) {
				if (e.target === dialog) {
					dialog.close();
				}
			});

			var swipeStartX = 0;
			var swipeStartY = 0;
			var swipeTracking = false;
			var swipeThreshold = 50;

			dialog.addEventListener('touchstart', function(e) {
				if (e.touches.length !== 1 || items.length < 2) {
					swipeTracking = false;
					return;
				}

				var target = e.target;
				if (video.contains(target) || (target.closest && target.closest('button'))) {
					swipeTracking = false;
					return;
				}

				swipeStartX = e.touches[0].clientX;
				swipeStartY = e.touches[0].clientY;
				swipeTracking = true;
			}, { passive: true });

			dialog.addEventListener('touchend', function(e) {
				if (!swipeTracking) {
					return;
				}
				swipeTracking = false;

				var touch = e.changedTouches[0];
				var dx = touch.clientX - swipeStartX;
				var dy = touch.clientY - swipeStartY;

				if (Math.abs(dx) < swipeThreshold || Math.abs(dx) < Math.abs(dy) * 1.2) {
					return;
				}

				show(current + (dx < 0 ? 1 : -1));
			}, { passive: true });

			dialog.addEventListener('touchcancel', function() {
				swipeTracking = false;
			}, { passive: true });

			document.addEventListener('keydown', function(e) {
				if (!dialog.open) {
					return;
				}

				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					show(current - 1);
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					show(current + 1);
				}
			});

			document.addEventListener('poh:consent', function(e) {
				if (dialog.open && items[current] && items[current].dataset.kind === 'video' && e.detail && e.detail.media) {
					loadVideo(items[current].dataset.youtubeId);
				}
			});
		})();
	</script>
}
