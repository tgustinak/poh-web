package templates

templ Home() {
	@Base("P.O.H") {
		<main class="flex min-h-screen items-center justify-center px-6">
			<div class="max-w-3xl text-center">
				<h1 class="text-5xl font-bold tracking-tight sm:text-7xl">
					Kapela <span class="text-orange-400">P.O.H</span>
				</h1>
				<div class="mt-6 inline-flex items-center rounded-full border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-300">
					<span class="mr-2 h-2 w-2 rounded-full bg-amber-400"></span>
					Work in progress..
				</div>
			</div>
		</main>
	}
}
