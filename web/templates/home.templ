package templates

import "github.com/tgustinak/pohkapela.sk/internal/concerts"

templ Home() {
	@Base("P.O.H") {
		@Navigation()
		<!-- hero -->
		<section id="domov" class="relative min-h-screen flex items-center justify-center overflow-hidden">
			<img src="/static/images/hero.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" widths="[640, 1024, 1920]}" sizes="100vw" loading="eager"/>
			<div class="absolute inset-0 bg-black/50"></div>
			<div class="relative text-center z-10">
				<h1 class="text-6xl md:text-8xl font-bold tracking-widest uppercase text-white">P.O.H</h1>
				<p class="mt-4 text-lg text-white/60 tracking-wide">Kapela Pohkapela</p>
			</div>
		</section>
		<!-- music -->
		@Music()
		<!-- concerts -->
		@Concerts([]concerts.Concert{
			{Name: "Kubínsky Jarmok", Day: 18, Month: "Jan"},
			{Name: "Kubínsky Jarmok", Day: 11, Month: "Feb"},
			{Name: "Kubínsky Jarmok", Day: 1, Month: "Mar"},
			{Name: "Kubínsky Jarmok", Day: 8, Month: "Apr"},
			{Name: "Kubínsky Jarmok", Day: 18, Month: "Sep"},
			{Name: "Gustove Narodky", Day: 26, Month: "Oct"},
		})
		<!-- merch -->
		<section id="merch" class="min-h-screen flex items-center justify-center bg-neutral-950">
			<h2 class="text-4xl font-bold tracking-wide text-white/90">Merch</h2>
		</section>
		<!-- video -->
		<section id="klipy" class="min-h-screen flex items-center justify-center bg-black">
			<h2 class="text-4xl font-bold tracking-wide text-white/90">Klipy</h2>
		</section>
		<!-- about -->
		<section id="o-nas" class="min-h-screen flex items-center justify-center bg-neutral-950">
			<h2 class="text-4xl font-bold tracking-wide text-white/90">O nás</h2>
		</section>
		<!-- gallery -->
		<section id="fotky" class="min-h-screen flex items-center justify-center bg-black">
			<h2 class="text-4xl font-bold tracking-wide text-white/90">Fotky</h2>
		</section>
		<!-- contact -->
		<section id="kontakt" class="min-h-screen flex items-center justify-center bg-neutral-950">
			<h2 class="text-4xl font-bold tracking-wide text-white/90">Kontakt</h2>
		</section>
	}
}
