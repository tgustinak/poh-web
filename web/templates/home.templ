package templates

import "github.com/tgustinak/pohkapela.sk/internal/concerts"

templ Home() {
	@Base("P.O.H") {
		@Navigation()
		<!-- hero -->
		<section id="domov" class="relative min-h-screen flex flex-col overflow-hidden bg-black">
			<img
				src="/static/images/hero.jpg"
				alt="Kapela P.O.H na pódiu"
				class="hero-kenburns absolute inset-0 w-full h-full object-cover"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/25 to-black/70"></div>
			<div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 35%, rgba(0,0,0,0.55) 100%)"></div>
			<div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-neutral-950 to-transparent"></div>
			<div class="relative z-10 flex flex-1 flex-col items-center justify-center text-center px-4 pt-20">
				<img
					src="/static/images/logo.svg"
					alt="P.O.H"
					class="hero-enter hero-float w-72 sm:w-80 md:w-96 h-auto drop-shadow-[0_10px_40px_rgba(0,0,0,0.9)]"
				/>
				<div class="hero-enter mt-8 flex items-center gap-4 sm:gap-5" style="animation-delay:250ms">
					<span class="h-px w-8 sm:w-16 bg-gradient-to-r from-transparent to-amber-400/70" aria-hidden="true"></span>
					<p class="text-center text-xs sm:text-sm md:text-base font-semibold uppercase tracking-[0.2em] sm:tracking-[0.25em] text-white/90">Folk-Rocková kapela z Dolného Kubína</p>
					<span class="h-px w-8 sm:w-16 bg-gradient-to-l from-transparent to-amber-400/70" aria-hidden="true"></span>
				</div>
			</div>
		</section>
		<!-- music -->
		@Music()
		<!-- concerts -->
		@Concerts([]concerts.Concert{
			{Name: "Kubínsky Jarmok", Day: 18, Month: "Jan"},
			{Name: "Kubínsky Jarmok", Day: 11, Month: "Feb"},
			{Name: "Kubínsky Jarmok", Day: 1, Month: "Mar"},
			{Name: "Kubínsky Jarmok", Day: 8, Month: "Apr"},
			{Name: "Kubínsky Jarmok", Day: 18, Month: "Sep"},
			{Name: "Gustove Narodky", Day: 26, Month: "Oct"},
		})
		<!-- merch -->
		@Merch()
		<!-- video -->
		@Klipy()
		<!-- about -->
		@About()
		<!-- social -->
		@Social()
		<!-- contact -->
		@Contact()
		@ConsentBanner()
	}
}
