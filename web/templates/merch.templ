package templates

templ Merch() {
	<section id="merch" class="bg-neutral-950 border-t border-white/5">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">Merch</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Merch</h2>
				<p class="mt-4 max-w-2xl mx-auto text-white/60">
					Tričko s motívom albumu Život. Zatiaľ len na koncertoch a cez správy.
				</p>
			</div>
			<div class="mt-16 grid gap-10 lg:grid-cols-2 lg:gap-14 items-center">
				<div>
					<div class="relative rounded-2xl overflow-hidden bg-white/[0.03] border border-white/10 shadow-2xl shadow-black/60">
						<span class="absolute top-4 left-4 z-10 rounded-full bg-amber-400 px-3 py-1 text-xs font-bold uppercase tracking-wider text-black">Novinka</span>
						<div class="flex gap-2 absolute top-4 right-4 z-10">
							<button type="button" id="merch-pill-front" class="merch-pill merch-pill-active" onclick="merchShow('front')">Predok</button>
							<button type="button" id="merch-pill-back" class="merch-pill" onclick="merchShow('back')">Chrbat</button>
						</div>
						<img
							id="merch-img-front"
							src="/static/images/merch-tricko-predok.jpg"
							alt="Čierne tričko P.O.H Život – predná strana s potlačou"
							class="w-full aspect-[5/4] object-cover object-top"
							loading="lazy"
						/>
						<img
							id="merch-img-back"
							src="/static/images/merch-tricko-chrbat.jpg"
							alt="Čierne tričko P.O.H Život – zadná strana s logom"
							class="w-full aspect-[5/4] object-cover object-top hidden"
							loading="lazy"
						/>
					</div>
					<div class="mt-4 grid grid-cols-2 gap-4">
						<button type="button" id="merch-thumb-front" class="merch-thumb merch-thumb-active" onclick="merchShow('front')">
							<img src="/static/images/merch-tricko-predok.jpg" alt="Náhľad – predok" class="w-full aspect-[5/4] object-cover object-top" loading="lazy"/>
						</button>
						<button type="button" id="merch-thumb-back" class="merch-thumb" onclick="merchShow('back')">
							<img src="/static/images/merch-tricko-chrbat.jpg" alt="Náhľad – chrbat" class="w-full aspect-[5/4] object-cover object-top" loading="lazy"/>
						</button>
					</div>
				</div>
				<div>
					<p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400/90">Tričko • Život</p>
					<h3 class="mt-2 text-3xl sm:text-4xl font-bold text-white">Tričko „Život“</h3>
					<p class="mt-4 text-white/60 leading-relaxed">
						Čierne tričko s prednou potlačou z albumu Život — dva portréty pri západe slnka.
						Vzadu malé logo p.o.h pod krkom.
					</p>
					<ul class="mt-6 space-y-2.5 text-sm text-white/70">
						<li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span> Predná potlač „Život“</li>
						<li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span> Zadné logo p.o.h</li>
						<li class="flex items-center gap-3"><span class="text-amber-400 font-bold">✓</span> Čierna farba</li>
					</ul>
					<div class="mt-8">
						<p class="text-xs font-semibold uppercase tracking-widest text-white/40">Veľkosť</p>
						<div class="mt-3 flex flex-wrap gap-2" id="merch-sizes">
							<button type="button" class="merch-size" onclick="merchSize(this)">S</button>
							<button type="button" class="merch-size merch-size-active" onclick="merchSize(this)">M</button>
							<button type="button" class="merch-size" onclick="merchSize(this)">L</button>
							<button type="button" class="merch-size" onclick="merchSize(this)">XL</button>
							<button type="button" class="merch-size" onclick="merchSize(this)">XXL</button>
						</div>
					</div>
					<div class="mt-8 flex flex-wrap items-center gap-4">
						<a
							href="#kontakt"
							class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-7 py-3 text-sm font-bold uppercase tracking-wider text-black transition hover:bg-amber-300"
						>
							Chcem tričko
							<span aria-hidden="true">→</span>
						</a>
						<p class="text-sm text-white/40">K dispozícii aj na koncertoch</p>
					</div>
				</div>
			</div>
		</div>
	</section>
	<script>
		function merchShow(which) {
			const front = which === 'front';
			document.getElementById('merch-img-front')?.classList.toggle('hidden', !front);
			document.getElementById('merch-img-back')?.classList.toggle('hidden', front);
			document.getElementById('merch-pill-front')?.classList.toggle('merch-pill-active', front);
			document.getElementById('merch-pill-back')?.classList.toggle('merch-pill-active', !front);
			document.getElementById('merch-thumb-front')?.classList.toggle('merch-thumb-active', front);
			document.getElementById('merch-thumb-back')?.classList.toggle('merch-thumb-active', !front);
		}
		function merchSize(btn) {
			document.querySelectorAll('#merch-sizes .merch-size').forEach(el => el.classList.remove('merch-size-active'));
			btn.classList.add('merch-size-active');
		}
	</script>
}
