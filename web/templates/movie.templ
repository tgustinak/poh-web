package templates

import (
	"strconv"

	"github.com/tgustinak/pohkapela.sk/internal/scripts"
	"github.com/tgustinak/pohkapela.sk/internal/videos"
)

templ Klipy(clips []videos.Video) {
	<section id="klipy" class="bg-black border-t border-white/5">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand-400">Videoklipy</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Klipy</h2>
				<p class="mt-4 max-w-2xl mx-auto text-white/60">
					Od najnovšieho singla až po naše prvé video. Vyber si z playlistu.
				</p>
			</div>
			if len(clips) == 0 {
				<p class="mt-16 text-center text-white/50">Zatiaľ žiadne klipy.</p>
			} else {
				<div class="mt-16 grid gap-8 lg:grid-cols-5 items-start">
					<div class="lg:col-span-3">
						<div id="klip-player-card" class="rounded-2xl overflow-hidden bg-neutral-900 border border-white/10 shadow-2xl shadow-black/60">
							<div class="aspect-video" id="klip-player-wrap" data-yt-embed data-current={ clips[0].YoutubeID }>
								<div data-yt-placeholder class="relative w-full h-full">
									<img
										src={ "https://i.ytimg.com/vi/" + clips[0].YoutubeID + "/hqdefault.jpg" }
										alt={ "Náhľad videa " + clips[0].Title }
										class="absolute inset-0 w-full h-full object-cover"
										loading="lazy"
									/>
									<button
										type="button"
										class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/40 transition hover:bg-black/25 cursor-pointer"
										data-id={ clips[0].YoutubeID }
										data-title={ clips[0].Title }
										data-date={ clips[0].Date }
										data-duration={ clips[0].Duration }
										onclick="klipPlay(this)"
									>
										<span class="flex items-center justify-center w-16 h-16 rounded-full bg-brand-400 text-black transition hover:scale-105">
											<svg class="w-6 h-6 ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
										</span>
										<span class="rounded-full border border-white/25 bg-black/70 px-5 py-2 text-xs font-bold uppercase tracking-wider text-white/85">Načítať video</span>
									</button>
								</div>
							</div>
							<div class="px-6 py-5 flex flex-wrap items-center justify-between gap-3 border-t border-white/10">
								<div class="min-w-0">
									<h3 id="klip-title" class="text-xl font-bold text-white truncate">{ clips[0].Title }</h3>
									<p id="klip-meta" class="mt-1 text-sm text-white/50">{ clips[0].Date } • { clips[0].Duration }</p>
								</div>
								<a
									id="klip-link"
									href={ "https://www.youtube.com/watch?v=" + clips[0].YoutubeID }
									target="_blank"
									rel="noopener"
									class="shrink-0 text-sm font-medium text-white/60 transition hover:text-brand-400"
								>
									Pozrieť na YouTube ↗
								</a>
							</div>
						</div>
					</div>
					<div class="lg:col-span-2">
						<p id="klip-list-head" class="px-1 pb-3 text-xs font-semibold uppercase tracking-[0.2em] text-white/40">Všetky klipy • { strconv.Itoa(len(clips)) }</p>
						<div id="klip-list" class="klip-list flex flex-col gap-3 lg:overflow-y-auto lg:pr-2">
							for i, c := range clips {
								@KlipRow(c.YoutubeID, c.Title, c.Date, c.Duration, i == 0)
							}
						</div>
					</div>
				</div>
			}
		</div>
	</section>
	@scripts.Defer("klipy", KlipyScripts())
}

templ KlipyScripts() {
	<script>
		function klipSyncHeights() {
			const card = document.getElementById('klip-player-card');
			const head = document.getElementById('klip-list-head');
			const list = document.getElementById('klip-list');
			if (!card || !list) {
				return;
			}
			if (window.innerWidth < 1024) {
				list.style.maxHeight = '';
				return;
			}
			const headHeight = head ? head.offsetHeight + 12 : 0;
			const height = card.offsetHeight - headHeight;
			if (height > 200) {
				list.style.maxHeight = height + 'px';
			}
		}

		window.addEventListener('resize', klipSyncHeights);
		window.addEventListener('load', klipSyncHeights);
		klipSyncHeights();

		function klipPlay(btn) {
			const id = btn.dataset.id;
			const wrap = document.getElementById('klip-player-wrap');
			if (wrap) {
				wrap.dataset.current = id;
			}
			const player = klipEnsurePlayer(true);
			if (player) {
				player.src = 'https://www.youtube-nocookie.com/embed/' + id + '?rel=0&autoplay=1';
			}
			const title = document.getElementById('klip-title');
			if (title) {
				title.textContent = btn.dataset.title || '';
			}
			const meta = document.getElementById('klip-meta');
			if (meta) {
				meta.textContent = (btn.dataset.date || '') + ' • ' + (btn.dataset.duration || '');
			}
			const link = document.getElementById('klip-link');
			if (link) {
				link.href = 'https://www.youtube.com/watch?v=' + id;
			}
			document.querySelectorAll('.klip-row').forEach(el => el.classList.toggle('klip-row-active', el === btn));
		}

		function klipEnsurePlayer(autoplay) {
			const wrap = document.getElementById('klip-player-wrap');
			if (!wrap) {
				return null;
			}
			let player = document.getElementById('klip-player');
			if (!player) {
				const id = wrap.dataset.current;
				if (!id) {
					return null;
				}
				player = document.createElement('iframe');
				player.id = 'klip-player';
				player.className = 'w-full h-full block';
				player.title = 'Videoklip P.O.H';
				player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
				player.allowFullscreen = true;
				player.loading = 'lazy';
				player.src = 'https://www.youtube-nocookie.com/embed/' + id + '?rel=0' + (autoplay ? '&autoplay=1' : '');
				const ph = wrap.querySelector('[data-yt-placeholder]');
				if (ph) {
					ph.remove();
				}
				wrap.appendChild(player);
			}
			return player;
		}

		(function klipConsentInit() {
			function storedConsent() {
				try {
					return window.pohGetConsent ? window.pohGetConsent() : null;
				} catch (e) {
					return null;
				}
			}
			const current = storedConsent();
			if (current && current.media) {
				klipEnsurePlayer(false);
			}
			document.addEventListener('poh:consent', (e) => {
				if (e.detail && e.detail.media) {
					klipEnsurePlayer(false);
				}
			});
		})();
	</script>
}

templ KlipRow(id string, title string, date string, duration string, isActive bool) {
	<button
		type="button"
		class={ "klip-row group", templ.KV("klip-row-active", isActive) }
		data-id={ id }
		data-title={ title }
		data-date={ date }
		data-duration={ duration }
		onclick="klipPlay(this)"
	>
		@KlipThumb(id, title, duration)
		<span class="min-w-0 flex-1 text-left">
			<span class="block font-semibold text-white/90 truncate">{ title }</span>
			<span class="mt-0.5 block text-xs text-white/50">{ date } • { duration }</span>
		</span>
	</button>
}

templ KlipThumb(id string, title string, duration string) {
	<span class="relative shrink-0 w-32 sm:w-36 aspect-video rounded-lg overflow-hidden bg-neutral-800">
		<img
			src={ "https://i.ytimg.com/vi/" + id + "/hqdefault.jpg" }
			alt={ "Náhľad videa " + title }
			class="w-full h-full object-cover"
			loading="lazy"
		/>
		<span class="absolute inset-0 flex items-center justify-center bg-black/20 transition group-hover:bg-black/40">
			<span class="flex items-center justify-center w-8 h-8 rounded-full bg-black/70 backdrop-blur border border-white/25">
				<svg class="w-3 h-3 ml-0.5 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
			</span>
		</span>
		<span class="absolute bottom-1 right-1 rounded bg-black/80 px-1.5 py-0.5 text-[10px] font-bold text-white/90">{ duration }</span>
	</span>
}
