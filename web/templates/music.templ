package templates

templ Music() {
	<section id="hudba" class="bg-neutral-950 border-t border-white/5">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">Diskografia</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Hudba</h2>
				<p class="mt-4 max-w-2xl mx-auto text-white/60">
					Od debutu Na konci sveta až po novinku Život. Vypočuj si naše štúdiové nahrávky.
				</p>
			</div>
			<div class="mt-16 grid gap-8 lg:grid-cols-5 items-start">
				<div class="grid gap-6 sm:grid-cols-2 lg:col-span-3">
					@AlbumCard(
						"/static/images/album-zivot.webp",
						"Obal albumu Život (2026)",
						"Život",
						"2026",
						"Novinka",
						true,
					)
					@AlbumCard(
						"/static/images/album-na-konci-sveta.jpg",
						"Obal albumu Na konci sveta (2021)",
						"Na konci sveta",
						"2021",
						"Debut",
						false,
					)
				</div>
				<div class="lg:col-span-2 rounded-2xl overflow-hidden bg-black border border-white/10 shadow-2xl shadow-black/60">
					<div class="flex items-center gap-3 px-6 py-5">
						<span class="w-2.5 h-2.5 rounded-full bg-[#1DB954] animate-pulse"></span>
						<div>
							<p class="text-sm font-bold uppercase tracking-wider text-white">Práve hráme</p>
							<p class="text-xs text-white/50">P.O.H na Spotify</p>
						</div>
					</div>
				<div data-media-embed data-media-src="https://open.spotify.com/embed/artist/79t3KrQngTRDooegKsR4cw?utm_source=generator&theme=0&si=e0f93c63516a49fb" data-media-height="352" data-media-title="P.O.H na Spotify" class="w-full overflow-hidden rounded-3xl bg-[#121212]">
					<div data-media-placeholder class="px-6 py-10 text-center">
						<span class="mx-auto flex items-center justify-center w-12 h-12 rounded-full bg-[#1DB954]/15 text-[#1DB954]">
							<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm4.6 14.4a.75.75 0 01-1 .25c-2.8-1.7-6.3-2.1-10.4-1.1a.75.75 0 11-.3-1.5c4.5-1 8.3-.6 11.4 1.3.4.2.5.7.3 1zM18 13a.75.75 0 01-1 .25c-2.4-1.4-6-1.9-8.8-1a.75.75 0 11-.6-1.4c3.2-1 7.1-.5 9.9 1.2.4.2.5.7.3 1zm.75-3.1a.75.75 0 01-1 .26c-2.7-1.7-7.2-2.2-10.7-1.2a.75.75 0 11-.4-1.45c4-1.15 8.9-.6 12 1.35.4.25.5.75.3 1.04z"></path></svg>
						</span>
						<p class="mt-4 text-sm font-bold uppercase tracking-wider text-white">Spotify prehrávač</p>
						<p class="mt-2 text-sm leading-relaxed text-white/50">Načítaním prehrávača dôjde k spojeniu so službou Spotify a môžu sa ukladať cookies tretích strán.</p>
						<button type="button" onclick="pohLoadMediaOne(this)" class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#1DB954] px-5 py-2.5 text-sm font-bold text-black transition hover:bg-[#1ed760] cursor-pointer">Načítať prehrávač</button>
					</div>
				</div>
					<div class="px-6 py-5 flex flex-wrap items-center gap-3">
						<a
							href="https://open.spotify.com/artist/79t3KrQngTRDooegKsR4cw"
							target="_blank"
							rel="noopener"
							class="inline-flex items-center gap-2 rounded-full bg-[#1DB954] px-5 py-2.5 text-sm font-bold text-black transition hover:bg-[#1ed760]"
						>
							@SpotifyIcon("w-4 h-4")
							Sledovať na Spotify
						</a>
						<a
							href="https://open.spotify.com/artist/79t3KrQngTRDooegKsR4cw"
							target="_blank"
							rel="noopener"
							class="text-sm font-medium text-white/60 transition hover:text-white"
						>
							Otvoriť v aplikácii ↗
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ AlbumCard(coverSrc string, coverAlt string, title string, year string, badge string, isNew bool) {
	<article class="group rounded-2xl overflow-hidden bg-white/[0.03] border border-white/10 transition-all duration-300 hover:-translate-y-1.5 hover:border-amber-400/40 hover:shadow-2xl hover:shadow-black/60">
		<div class="relative aspect-square overflow-hidden">
			<img
				src={ coverSrc }
				alt={ coverAlt }
				class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
			if isNew {
				<span class="absolute top-4 left-4 rounded-full bg-amber-400 px-3 py-1 text-xs font-bold uppercase tracking-wider text-black">{ badge }</span>
			} else {
				<span class="absolute top-4 left-4 rounded-full bg-black/70 backdrop-blur px-3 py-1 text-xs font-bold uppercase tracking-wider text-white/90 border border-white/20">{ badge }</span>
			}
			<span class="absolute bottom-4 right-4 rounded-full bg-black/70 backdrop-blur px-3 py-1 text-xs font-bold tracking-wider text-white/90 border border-white/20">{ year }</span>
		</div>
		<div class="p-6">
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-400/90">Štúdiový album</p>
			<h3 class="mt-2 text-2xl font-bold text-white">{ title }</h3>
			<p class="mt-1 text-sm text-white/50">{ year } • P.O.H</p>
			<a
				href="https://open.spotify.com/artist/79t3KrQngTRDooegKsR4cw"
				target="_blank"
				rel="noopener"
				class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-sm font-medium text-white/80 transition hover:border-[#1DB954] hover:text-[#1DB954]"
			>
				@SpotifyIcon("w-4 h-4")
				Prehrať na Spotify
			</a>
		</div>
	</article>
}

templ SpotifyIcon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.36.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"></path>
	</svg>
}
