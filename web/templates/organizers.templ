package templates

import (
	"github.com/tgustinak/pohkapela.sk/internal/contact"
	"github.com/tgustinak/pohkapela.sk/internal/organizers"
)

templ Organizers(c contact.Contact, docs []organizers.Document, photos []organizers.Photo) {
	@Base("P.O.H – Pre organizátorov") {
		<header class="border-b border-white/10 bg-black">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
				<a href="/" class="transition-transform duration-300 hover:scale-105">
					<img src="/static/images/logo.svg" alt="P.O.H" class="h-10 w-auto"/>
				</a>
				<a href="/" class="text-sm font-semibold uppercase tracking-wider text-white/60 transition hover:text-brand-400">
					← Späť na web
				</a>
			</div>
		</header>
		<main class="bg-neutral-950">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
				<div class="max-w-2xl">
					<p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand-400">Booking</p>
					<h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Pre organizátorov</h1>
					<p class="mt-4 text-white/60 leading-relaxed">
						Chcete kapelu P.O.H na vašu akciu? Napíšte nám — radi prídeme zahrať.
					</p>
				</div>
				<div class="mt-12 max-w-4xl rounded-2xl border border-white/10 bg-black/40 p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-5">
					if c.PhotoPath != "" {
						<img
							src={ c.PhotoPath }
							alt={ c.Name + " – " + c.Role + " kapely P.O.H" }
							class="shrink-0 w-20 h-20 rounded-full object-cover ring-2 ring-brand-400/60"
							loading="lazy"
						/>
					} else {
						<img
							src="/static/images/manager.webp"
							alt={ c.Name + " – " + c.Role + " kapely P.O.H" }
							class="shrink-0 w-20 h-20 rounded-full object-cover ring-2 ring-brand-400/60"
							loading="lazy"
						/>
					}
					<div class="min-w-0 flex-1">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-400/90">{ c.Role } • booking</p>
						<p class="mt-1 text-lg font-bold text-white">{ c.Name }</p>
					</div>
					<div class="flex flex-wrap gap-3">
						<a href={ "tel:" + c.Phone } class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white/80 transition hover:border-brand-400 hover:text-brand-400">
							{ contact.DisplayPhone(c.Phone) }
						</a>
						<a href={ "mailto:" + c.Email } class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-white/80 transition hover:border-brand-400 hover:text-brand-400">
							{ c.Email }
						</a>
					</div>
				</div>
				<div id="materialy" class="mt-16 max-w-4xl scroll-mt-24">
					<p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand-400">Na stiahnutie</p>
					<h2 class="mt-3 text-3xl font-bold tracking-wide text-white/90">Materiály na stiahnutie</h2>
					<div class="mt-8 flex flex-col gap-3">
						for _, d := range docs {
							@DownloadRow(d.FilePath, d.DisplayName, d.Meta)
						}
					</div>
					<div class="mt-6 grid gap-6 sm:grid-cols-2">
						for _, p := range photos {
							@PhotoCard(p.PreviewPath, p.FilePath, organizers.PhotoAlt(p), p.MetaLabel)
						}
					</div>
				</div>
			</div>
		</main>
		@Footer() {
			<a href="/" class="text-sm font-semibold text-white/60 transition hover:text-brand-400">Späť na hlavnú stránku →</a>
		}
		@ConsentBanner()
	}
}

templ DownloadRow(href string, name string, meta string) {
	<a
		href={ href }
		download
		class="group flex items-center gap-4 rounded-xl border border-white/10 bg-white/[0.03] px-5 py-4 transition hover:border-brand-400/50"
	>
		<span class="flex items-center justify-center w-10 h-10 shrink-0 rounded-lg bg-brand-400/10 text-brand-400 transition group-hover:bg-brand-400 group-hover:text-black">
			<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M14 2H7a2 2 0 00-2 2v16a2 2 0 002 2h10a2 2 0 002-2V7l-5-5z"></path>
				<path d="M14 2v5h5"></path>
			</svg>
		</span>
		<span class="min-w-0 flex-1 text-left">
			<span class="block font-semibold text-white">{ name }</span>
			<span class="mt-0.5 block text-xs uppercase tracking-wider text-white/40">{ meta }</span>
		</span>
		<span class="shrink-0 inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white/70 transition group-hover:border-brand-400 group-hover:text-brand-400">
			Stiahnuť
			<span aria-hidden="true">↓</span>
		</span>
	</a>
}

templ PhotoCard(preview string, href string, alt string, meta string) {
	<div class="rounded-2xl overflow-hidden border border-white/10 bg-white/[0.03]">
		<img
			src={ preview }
			alt={ alt }
			class="w-full h-80 object-cover object-top"
			loading="lazy"
		/>
		<div class="flex items-center justify-between gap-3 px-5 py-4 border-t border-white/10">
			<span class="text-xs uppercase tracking-wider text-white/40">{ meta }</span>
			<a
				href={ href }
				download
				class="shrink-0 inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white/70 transition hover:border-brand-400 hover:text-brand-400"
			>
				Plná kvalita
				<span aria-hidden="true">↓</span>
			</a>
		</div>
	</div>
}
