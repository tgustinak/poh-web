package templates

import (
	"github.com/tgustinak/pohkapela.sk/internal/social"
)

templ Social(links []social.Link) {
	<section id="social" class="bg-black border-t border-white/5">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
			<div class="text-center">
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">Sociálne siete</p>
				<h2 class="mt-3 text-4xl md:text-5xl font-bold tracking-wide text-white/90">Social</h2>
				<p class="mt-4 max-w-2xl mx-auto text-white/60">
					Sleduj nás — nové termíny, fotky a zákulisie. Počúvaj nás, kde ti to vyhovuje.
				</p>
			</div>
			<div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				for _, l := range links {
					@SocialCard(l.Platform, l.DisplayName, l.Handle, l.URL, l.CTA)
				}
			</div>
		</div>
	</section>
}

templ SocialCard(platform string, name string, handle string, url string, cta string) {
	<div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/60 hover:border-white/25">
		@SocialTile(platform)
		<h3 class="mt-5 text-xl font-bold text-white">{ name }</h3>
		<p class="mt-1 text-sm text-white/50">{ handle }</p>
		<a
			href={ url }
			target="_blank"
			rel="noopener"
			class={ "mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-bold uppercase tracking-wider transition", SocialButtonClass(platform) }
		>
			{ cta }
			<span aria-hidden="true">↗</span>
		</a>
	</div>
}

func SocialButtonClass(platform string) string {
	switch platform {
	case "facebook":
		return "bg-[#1877F2] text-white hover:bg-[#1667d9]"
	case "instagram":
		return "bg-gradient-to-r from-[#f9ce34] via-[#ee2a7b] to-[#6228d7] text-white hover:opacity-90"
	case "youtube":
		return "bg-[#FF0000] text-white hover:bg-[#d90000]"
	case "spotify":
		return "bg-[#1DB954] text-black hover:bg-[#1ed760]"
	case "ytmusic":
		return "bg-white text-black hover:bg-white/85"
	case "apple":
		return "bg-gradient-to-r from-[#fa2d48] to-[#fc5c7d] text-white hover:opacity-90"
	default:
		return "bg-white/10 text-white hover:bg-white/20"
	}
}

templ SocialTile(platform string) {
	if platform == "facebook" {
		<div class="mx-auto flex items-center justify-center w-14 h-14 rounded-2xl bg-[#1877F2] shadow-lg shadow-[#1877F2]/25">
			<svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5z"></path>
			</svg>
		</div>
	} else if platform == "instagram" {
		<div class="mx-auto flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-[#f9ce34] via-[#ee2a7b] to-[#6228d7] shadow-lg shadow-[#ee2a7b]/25">
			<svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
				<circle cx="12" cy="12" r="4.2"></circle>
				<circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none"></circle>
			</svg>
		</div>
	} else if platform == "youtube" {
		<div class="mx-auto flex items-center justify-center w-14 h-14 rounded-2xl bg-[#FF0000] shadow-lg shadow-[#FF0000]/25">
			<svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M8 5.5v13l11-6.5z"></path>
			</svg>
		</div>
	} else if platform == "spotify" {
		<div class="mx-auto flex items-center justify-center w-14 h-14 rounded-2xl bg-[#1DB954] shadow-lg shadow-[#1DB954]/25">
			@SpotifyIcon("w-7 h-7 text-black")
		</div>
	} else if platform == "ytmusic" {
		<div class="mx-auto flex items-center justify-center w-14 h-14 rounded-2xl bg-[#212121] border border-white/15">
			<span class="flex items-center justify-center w-8 h-8 rounded-full bg-[#FF0000]">
				<svg class="w-3.5 h-3.5 ml-0.5 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M8 5.5v13l11-6.5z"></path>
				</svg>
			</span>
		</div>
	} else if platform == "apple" {
		<div class="mx-auto flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-[#fa2d48] to-[#fc5c7d] shadow-lg shadow-[#fa2d48]/25">
			<svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M9 18V5l11-2.5V16"></path>
				<circle cx="6.5" cy="18" r="2.5" fill="currentColor" stroke="none"></circle>
				<circle cx="17.5" cy="16" r="2.5" fill="currentColor" stroke="none"></circle>
			</svg>
		</div>
	}
}
